{
    "name": "davix/customs-domain",
    "description": "Platform-agnostic customs and tariff domain logic: commodity code validation, UK Trade Tariff mapping, and compliance rules.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "customs",
        "tariff",
        "hs-code",
        "commodity-code",
        "hmrc",
        "uk-trade-tariff",
        "compliance"
    ],
    "authors": [
        {
            "name": "Davix"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Davix\\Customs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Davix\\Customs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "boundary": "bash bin/check-boundary.sh src",
        "nullsafe": "python3 bin/check-nullsafe.py src tests",
        "check": [
            "@boundary",
            "@characters",
            "@nullsafe",
            "@analyse",
            "@test"
        ],
        "characters": "python3 bin/check-characters.py"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}